{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-brain.invalid/schemas/error-v1.schema.json",
  "title": "agent-brain command error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_status", "error"],
  "properties": {
    "schema_version": {"const": 1},
    "operation_status": {"const": "error"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "cause", "affected_scope", "retry_eligible", "next_action"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "cause": {"type": "string", "minLength": 1},
        "affected_scope": {"type": "string", "minLength": 1},
        "retry_eligible": {"type": "boolean"},
        "next_action": {"type": "string", "minLength": 1}
      }
    }
  }
}
