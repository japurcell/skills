{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-brain.invalid/schemas/config-v1.schema.json",
  "title": "agent-brain repository configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "knowledge_roots", "mapped_units", "startup"],
  "properties": {
    "schema_version": {"const": 1},
    "repository_id": {"type": "string", "format": "uuid"},
    "knowledge_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/knowledgeRoot"}
    },
    "mapped_units": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/mappedUnit"},
      "description": "The typed validator also rejects duplicate IDs and repeated selectors for one source path. All mappings are read-only."
    },
    "providers": {
      "type": "object", "propertyNames": {"$ref": "#/$defs/text"}, "additionalProperties": {"$ref": "#/$defs/provider"},
      "description": "Absent or unconfigured integrations are disabled. M3 accepts only disposable protocol fixtures; native kind remains unsupported."
    },
    "state_dir": {"allOf": [{"$ref": "#/$defs/repositoryPath"}, {"pattern": "^\\.agents/context/.+"}]},
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "lease_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 1800},
        "contention_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "check_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60}
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false, "required": ["required", "trusted"],
      "properties": {
        "required": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/text"},
          "allOf": [{"contains": {"const": "guidance"}}, {"contains": {"const": "review_sources"}}]},
        "trusted": {"type": "array", "items": {"$ref": "#/$defs/checker"}}
      },
      "description": "Required IDs must resolve to built-ins or unique explicitly trusted IDs. No caller-supplied receipt or passed flag is accepted."
    },
    "startup": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/startupRead"},
      "description": "References may target inline annotations or mapped units; unresolved IDs, duplicate IDs, and candidate startup guidance are rejected or surfaced as gaps by the typed validator."
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "kind", "core_version", "adapter_version", "schema_version", "certification_id", "support_record", "events", "max_attempts"],
      "properties": {
        "enabled": {"type": "boolean"}, "kind": {"enum": ["native", "protocol_fixture"]},
        "core_version": {"$ref": "#/$defs/text"}, "adapter_version": {"$ref": "#/$defs/text"},
        "schema_version": {"const": 1}, "certification_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "support_record": {"$ref": "#/$defs/repositoryPath"},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {
          "enum": ["startup", "task", "scope", "checkpoint", "resume", "context_lost", "recover", "pause", "cancel", "child_start", "child_stop"]}}
      }
    },
    "checker": {
      "type": "object", "additionalProperties": false, "required": ["id", "argv", "timeout_seconds"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "argv": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/text"}, {"pattern": "^[^\\u0000]*$"}]}},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60}
      }
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\\\)(?!.*\\u0000)[^\\\\]+$",
      "description": "Repository-relative POSIX path; the typed validator rejects absolute paths, Windows drives, dot segments, NUL characters, and backslashes."
    },
    "knowledgeRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "ownership"],
      "properties": {
        "path": {"oneOf": [{"const": "."}, {"$ref": "#/$defs/repositoryPath"}]},
        "ownership": {"enum": ["read_only", "agent_brain"]}
      }
    },
    "mappedUnit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path", "unit"],
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "path": {"$ref": "#/$defs/repositoryPath"},
            "unit": {"const": "whole"}
          },
          "description": "Legacy M1 shorthand for an established whole-document policy mapping."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path", "selector", "kind", "status"],
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "path": {"$ref": "#/$defs/repositoryPath"},
            "selector": {"$ref": "#/$defs/selector"},
            "kind": {"enum": ["policy", "fact"]},
            "status": {"enum": ["established", "candidate"]},
            "applies": {"$ref": "#/$defs/applies"},
            "requires": {"$ref": "#/$defs/requires"},
            "evidence": {"type": "object"}
          },
          "description": "Read-only external mapping. The selector and metadata live in config so a protected source document need not be edited."
        }
      ]
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "document"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "heading"],
          "properties": {"type": {"const": "section"}, "heading": {"type": "string", "minLength": 1, "pattern": "\\S"}}
        }
      ]
    },
    "applies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {"$ref": "#/$defs/selectorList"},
        "concepts": {"$ref": "#/$defs/selectorList"},
        "actions": {"$ref": "#/$defs/selectorList"},
        "dependencies": {"$ref": "#/$defs/selectorList"},
        "providers": {"$ref": "#/$defs/selectorList"},
        "runtimes": {"$ref": "#/$defs/selectorList"}
      }
    },
    "selectorList": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "loading_mode"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "loading_mode": {"enum": ["unit", "whole"]}
        }
      },
      "description": "The typed validator also rejects repeated reference IDs, even when their loading modes differ."
    },
    "startupRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "loading_mode"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "loading_mode": {"enum": ["unit", "whole"]}
      }
    }
  }
}
