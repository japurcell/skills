{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-brain.invalid/schemas/proposal-v1.schema.json",
  "title": "Foreground evidenced exact change set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "review",
    "proposal"
  ],
  "properties": {
    "source_ingestion": {
      "$ref": "source-ingestion-v1.schema.json#/$defs/review"
    },
    "schema_version": {
      "const": 1
    },
    "outcome": {
      "const": "changed"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "guidance",
        "sources",
        "note"
      ],
      "properties": {
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "concepts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "actions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "dependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "providers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "runtimes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "guidance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "content_revision",
              "input_revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "content_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "input_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "revision",
              "note"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_input_revision",
        "rationale",
        "changes",
        "claims"
      ],
      "properties": {
        "base_input_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "base_revision",
              "content"
            ],
            "properties": {
              "path": {
                "$ref": "config-v1.schema.json#/$defs/repositoryPath"
              },
              "base_revision": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "content": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "action",
              "scope",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "enum": [
                  "fact",
                  "tip",
                  "rule",
                  "relocation"
                ]
              },
              "action": {
                "enum": [
                  "add",
                  "correct",
                  "prune",
                  "relocate"
                ]
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                  "paths": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "concepts": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "actions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "dependencies": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "providers": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "runtimes": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              },
              "evidence": {
                "type": "object",
                "required": [
                  "verified_at",
                  "result"
                ],
                "properties": {
                  "verified_at": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "failure": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "workaround": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "basis": {
                    "enum": [
                      "error",
                      "obsolete",
                      "complete_redundancy"
                    ]
                  },
                  "basis_note": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "revision",
                      "note"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "revision": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "note": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  },
                  "checks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "maintenance-v1.schema.json#/$defs/disposition"
      }
    }
  }
}
