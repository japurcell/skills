{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-brain.invalid/schemas/inspection-v1.schema.json",
  "title": "agent-brain doctor or status result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation_status", "command", "setup_status", "config_path",
    "config_present", "runtime_state_path", "runtime_state_present", "active_context", "model_execution", "checks"
  ],
  "properties": {
    "native_foreground": {"type": "object", "additionalProperties": false, "required": ["pending", "closed"], "properties": {"pending": {"type": "integer", "minimum": 0}, "closed": {"type": "integer", "minimum": 0}}},
    "maintenance": {
      "$ref": "maintenance-v1.schema.json"
    },
      "publication_recovery": {
        "type": "object",
        "required": [
          "history_path",
          "paths"
        ],
        "properties": {
          "history_path": {
            "$ref": "config-v1.schema.json#/$defs/repositoryPath"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
    "schema_version": {"const": 1},
    "operation_status": {"const": "ok"},
    "command": {"enum": ["doctor", "status"]},
    "setup_status": {"enum": ["uninitialized", "configured", "invalid"]},
    "config_path": {"type": "string", "minLength": 1},
    "config_present": {"type": "boolean"},
    "runtime_state_path": {"type": "string", "minLength": 1},
    "runtime_state_present": {"type": "boolean"},
    "active_context": {"const": "unavailable"},
    "model_execution": {"const": "disabled"},
    "state_status": {"enum": ["absent", "available", "unavailable"]},
    "worktree_id": {"type": "string", "format": "uuid"},
    "work_sessions": {"type": "array", "items": {"type": "object"}},
    "work_session_status": {"const": "incomplete"},
    "pending_work": {"const": "unknown"},
    "error": {"type": "object"},
    "sqlite_capabilities": {"type": "object", "description": "Observed connection settings with read-only/read-write access identified; filesystem durability remains unverified."},
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "detail"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["present", "missing", "invalid", "unavailable", "disabled"]},
        "detail": {"type": "string"}
      }
    }
  }
}
