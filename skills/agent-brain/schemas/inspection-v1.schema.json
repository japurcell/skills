{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-brain.invalid/schemas/inspection-v1.schema.json",
  "title": "agent-brain doctor or status result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation_status", "command", "setup_status", "config_path",
    "config_present", "runtime_state_path", "runtime_state_present", "active_context", "model_execution", "checks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "operation_status": {"const": "ok"},
    "command": {"enum": ["doctor", "status"]},
    "setup_status": {"enum": ["uninitialized", "configured", "invalid"]},
    "config_path": {"type": "string", "minLength": 1},
    "config_present": {"type": "boolean"},
    "runtime_state_path": {"type": "string", "minLength": 1},
    "runtime_state_present": {"type": "boolean"},
    "active_context": {"const": "unavailable"},
    "model_execution": {"const": "disabled"},
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "detail"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["present", "missing", "invalid", "unavailable", "disabled"]},
        "detail": {"type": "string"}
      }
    }
  }
}
