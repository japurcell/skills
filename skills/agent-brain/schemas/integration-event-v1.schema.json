{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-brain.invalid/schemas/integration-event-v1.schema.json",
  "title": "Normalized integration event v1 (fixture protocol only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event",
    "integration",
    "binding",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "event": {
      "enum": [
        "startup",
        "task",
        "scope",
        "checkpoint",
        "resume",
        "context_lost",
        "recover",
        "pause",
        "cancel",
        "child_start",
        "child_stop"
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "core_version",
        "adapter_version",
        "certification_id",
        "config_revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "core_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "certification_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "config_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_root",
        "worktree_root",
        "provider_session_id",
        "provider_task_id",
        "provider_agent_id"
      ],
      "properties": {
        "repository_root": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "worktree_root": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider_session_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider_task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider_agent_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "concepts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "runtimes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "classification": {
      "enum": [
        "active",
        "awaiting_user",
        "ready_to_complete"
      ]
    },
    "parent_agent_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "assigned_obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "const": "scope_review"
      }
    },
    "stage_generated": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "timestamp": {
      "type": [
        "string",
        "number"
      ],
      "description": "Diagnostic only; never used for expiry, renewal, or authority."
    },
    "review_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    }
  }
}
