{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/load-required-skills.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\load-required-skills.py\"",
            "timeout": 5,
            "statusMessage": "Loading required skill context",
            "additionalContextLimit": 8000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/rtk-explicit-codex.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\rtk-explicit-codex.py\"",
            "timeout": 5,
            "statusMessage": "Checking explicit RTK command"
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/markdown-health.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\markdown-health.py\"",
            "env": {"MARKDOWN_HEALTH_EVENT": "pre"},
            "timeout": 10,
            "statusMessage": "Recording Markdown baseline"
          },
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scan-secrets.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\scan-secrets.py\"",
            "timeout": 10,
            "statusMessage": "Scanning modified files for secrets"
          },
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/tool-guard.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\tool-guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking dangerous tool actions"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/markdown-health.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\markdown-health.py\"",
            "env": {"MARKDOWN_HEALTH_EVENT": "post"},
            "timeout": 10,
            "statusMessage": "Checking touched Markdown"
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/repository-state.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\repository-state.py\"",
            "timeout": 10,
            "statusMessage": "Protecting Git state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/markdown-health.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\markdown-health.py\"",
            "env": {"MARKDOWN_HEALTH_EVENT": "final"},
            "timeout": 10,
            "statusMessage": "Checking Markdown before completion"
          },
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scan-secrets.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\scan-secrets.py\"",
            "timeout": 10,
            "statusMessage": "Checking modified files for secrets"
          }
        ]
      }
    ]
  }
}
