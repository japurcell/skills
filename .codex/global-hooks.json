{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/load-required-skills.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\load-required-skills.py\"",
            "timeout": 5,
            "statusMessage": "Loading required skill context",
            "additionalContextLimit": 8000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/inject-brain.py --provider codex",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\inject-brain.py\" --provider codex",
            "timeout": 5,
            "statusMessage": "Loading brain index",
            "additionalContextLimit": 0
          }
        ],
        "matcher": "startup|resume|clear|compact|fork"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scan-status.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\scan-status.py\"",
            "timeout": 2,
            "statusMessage": "Reading last secret-scan status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/auto-index-brain.py --provider codex",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\auto-index-brain.py\" --provider codex",
            "timeout": 5,
            "statusMessage": "Updating brain index"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/tool-guard.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\tool-guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking dangerous tool actions"
          }
        ],
        "matcher": "Bash|apply_patch|Edit|Write"
      }
    ]
  }
}
