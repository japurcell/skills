{
  "context": {
    "fileName": ["AGENTS.md", "GEMINI.md"]
  },
  "experimental": {
    "autoMemory": false,
    "dynamicModelConfiguration": true,
    "modelSteering": true
  },
  "general": {
    "enableAutoUpdate": false,
    "enableNotifications": true,
    "plan": {
      "directory": ".agents/scratchpad"
    }
  },
  "ide": {
    "hasSeenNudge": true,
    "enabled": true
  },
  "mcp": {
    "allowed": ["google-developer-knowledge"]
  },
  "mcpServers": {
    "google-developer-knowledge": {
      "url": "https://developerknowledge.googleapis.com/mcp",
      "type": "http",
      "authProviderType": "google_credentials",
      "oauth": {
        "scopes": ["https://www.googleapis.com/auth/userinfo.email"]
      },
      "headers": {
        "x-goog-user-project": "usfs-code-assist"
      }
    }
  },
  "model": {
    "name": "auto"
  },
  "modelConfigs": {
    "modelDefinitions": {
      "gemini-3.8-flash": {
        "tier": "flash",
        "family": "gemini-3",
        "isPreview": false,
        "isVisible": true,
        "features": {
          "thinking": true,
          "multimodalToolUse": true
        }
      }
    },
    "modelIdResolutions": {
      "gemini-3.8-flash": {
        "default": "gemini-3.8-flash"
      }
    }
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal",
      "enforcedType": "oauth-personal"
    }
  },
  "ui": {
    "footer": {
      "hideContextPercentage": false,
      "showLabels": true,
      "items": [
        "workspace",
        "git-branch",
        "model-name",
        "context-used",
        "token-count",
        "quota"
      ]
    },
    "inlineThinkingMode": "full",
    "showMemoryUsage": true,
    "showModelInfoInChat": true,
    "showStatusInTitle": true
  },
  "agents": {
    "overrides": {
      "addy-code-reviewer": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "addy-security-auditor": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "addy-test-engineer": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "analyzer": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "architecture-critic": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "browser_agent": {
        "enabled": true
      },
      "business-rules-extractor": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "code-architect": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "code-explorer": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "code-reviewer": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "code-simplifier": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "codebase_investigator": {
        "runConfig": {
          "maxTurns": 50,
          "maxTimeMinutes": 30
        }
      },
      "comparator": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "generalist": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "grader": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "legacy-analyst": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "scaffolder": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "security-auditor": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "test-engineer": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "ui-auditor": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "uplift-migrator": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "version-delta-analyst": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/send-event.py\"",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "SessionStart"
            }
          },
          {
            "name": "skill-context-injector",
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/skill-context-injector.py\"",
            "description": "Loads required skill files and injects them as context before each agent turn.",
            "env": {
              "AGENTS_REQUIRED_SKILL_FILES": "caveman/SKILL.md"
            }
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/send-event.py\"",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "AfterAgent"
            }
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/send-event.py\"",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "BeforeAgent"
            }
          }
        ]
      }
    ],
    "BeforeModel": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/send-event.py\"",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "BeforeModel"
            }
          }
        ]
      }
    ],
    "AfterModel": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/send-event.py\"",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "AfterModel"
            }
          }
        ]
      }
    ],
    "BeforeToolSelection": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/send-event.py\"",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "BeforeToolSelection"
            }
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/send-event.py\"",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "BeforeTool"
            }
          },
          {
            "name": "tool-guard",
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/tool-guard.py\"",
            "description": "Blocks dangerous Gemini tool invocations using same policy patterns as Copilot tool-guard."
          },
          {
            "name": "scan-secrets",
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/scan-secrets.py\"",
            "env": {
              "SCAN_MODE": "block",
              "SCAN_SCOPE": "diff"
            },
            "description": "Scans workspace diffs for secrets before running any tool."
          }
        ]
      },
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/rtk-hook-gemini.py\"",
            "timeout": 5000
          },
          {
            "name": "rtk-explicit-command",
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/rtk-explicit-gemini.py\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/send-event.py\"",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "AfterTool"
            }
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/send-event.py\"",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "PreCompress"
            }
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/send-event.py\"",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "Notification"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/send-event.py\"",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "SessionEnd"
            }
          },
          {
            "name": "scan-secrets",
            "type": "command",
            "command": "python \"$HOME/.gemini/hooks/scripts/scan-secrets.py\"",
            "env": {
              "SCAN_MODE": "warn"
            },
            "description": "Scans modified files for potential secrets and logs env-file access during Gemini session shutdown."
          }
        ]
      }
    ]
  }
}
