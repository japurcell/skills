{
  "context": {
    "fileName": ["AGENTS.md", "GEMINI.md"]
  },
  "experimental": {
    "modelSteering": true
  },
  "general": {
    "enableAutoUpdate": false,
    "enableNotifications": true,
    "plan": {
      "directory": ".agents/scratchpad"
    }
  },
  "ide": {
    "hasSeenNudge": true,
    "enabled": true
  },
  "model": {
    "name": "auto"
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "footer": {
      "hideContextPercentage": false,
      "showLabels": true,
      "items": [
        "workspace",
        "git-branch",
        "model-name",
        "context-used",
        "token-count",
        "quota"
      ]
    },
    "showMemoryUsage": true,
    "showModelInfoInChat": true,
    "showStatusInTitle": true
  },
  "agents": {
    "overrides": {
      "addy-code-reviewer": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "addy-security-auditor": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "addy-test-engineer": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "analyzer": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "architecture-critic": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "browser_agent": {
        "enabled": true
      },
      "business-rules-extractor": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "code-architect": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "code-explorer": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "code-reviewer": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "code-simplifier": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "codebase_investigator": {
        "runConfig": {
          "maxTurns": 50,
          "maxTimeMinutes": 30
        }
      },
      "comparator": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "generalist": {
        "runConfig": {
          "maxTurns": 50,
          "maxTimeMinutes": 30
        }
      },
      "grader": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "legacy-analyst": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "scaffolder": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "security-auditor": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "test-engineer": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "ui-auditor": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "uplift-migrator": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "version-delta-analyst": {
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/send-event.py",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "SessionStart"
            }
          },
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/log-session-start.py"
          },
          {
            "name": "skill-context-injector",
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/skill-context-injector.py",
            "description": "Loads required skill files and injects them as context before each agent turn.",
            "env": {
              "AGENTS_REQUIRED_SKILL_FILES": "caveman/SKILL.md,context-engineering/SKILL.md"
            }
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "name": "auto-ingest-sources",
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/auto-ingest.py",
            "description": "Scans .agents/sources at startup and injects stale source-summary context."
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/send-event.py",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "AfterAgent"
            }
          },
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/log-after-agent.py"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/send-event.py",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "BeforeAgent"
            }
          }
        ]
      }
    ],
    "BeforeModel": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/send-event.py",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "BeforeModel"
            }
          }
        ]
      }
    ],
    "AfterModel": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/send-event.py",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "AfterModel"
            }
          }
        ]
      }
    ],
    "BeforeToolSelection": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/send-event.py",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "BeforeToolSelection"
            }
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/send-event.py",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "BeforeTool"
            }
          },
          {
            "name": "tool-guard",
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/tool-guard.py",
            "description": "Blocks dangerous Gemini tool invocations using same policy patterns as Copilot tool-guard."
          }
        ]
      },
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/rtk-hook-gemini.py"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/send-event.py",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "AfterTool"
            }
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/send-event.py",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "PreCompress"
            }
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/send-event.py",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "Notification"
            }
          },
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/log-notification.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/send-event.py",
            "env": {
              "OBSERVABILITY_CAPTURE_EVENT": "true",
              "OBSERVABILITY_SOURCE_EVENT_NAME": "SessionEnd"
            }
          },
          {
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/log-session-end.py"
          },
          {
            "name": "scan-secrets",
            "type": "command",
            "command": "$HOME/.gemini/hooks/scripts/scan-secrets.py",
            "description": "Scans modified files for potential secrets and logs env-file access during Gemini session shutdown."
          }
        ]
      }
    ]
  }
}
