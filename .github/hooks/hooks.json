{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/validate-stop.py",
        "powershell": "python \".github/hooks/scripts/validate-stop.py\"",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/validate-stop.py",
        "powershell": "python \".github/hooks/scripts/validate-stop.py\"",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell|create|edit",
        "bash": ".github/hooks/scripts/lint-okf.py",
        "powershell": "python \".github/hooks/scripts/lint-okf.py\"",
        "timeoutSec": 10
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/auto-ingest-source.py",
        "powershell": "python \".github/hooks/scripts/auto-ingest-source.py\""
      }
    ],
    "userPromptTransformed": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/inject-auto-ingest-context.py",
        "powershell": "python \".github/hooks/scripts/inject-auto-ingest-context.py\""
      }
    ]
  }
}
