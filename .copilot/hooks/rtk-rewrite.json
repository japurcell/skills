{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/rtk-hook-copilot.py",
        "powershell": "python \"$HOME/.copilot/hooks/scripts/rtk-hook-copilot.py\"",
        "cwd": ".",
        "timeoutSec": 5
      },
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/rtk-explicit-copilot.py",
        "powershell": "python \"$HOME/.copilot/hooks/scripts/rtk-explicit-copilot.py\"",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/rtk-hook-copilot.py",
        "powershell": "python \"$HOME/.copilot/hooks/scripts/rtk-hook-copilot.py\"",
        "cwd": ".",
        "timeoutSec": 5
      },
      {
        "type": "command",
        "matcher": "bash|powershell",
        "bash": "$HOME/.copilot/hooks/scripts/rtk-explicit-copilot.py",
        "powershell": "python \"$HOME/.copilot/hooks/scripts/rtk-explicit-copilot.py\"",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}
