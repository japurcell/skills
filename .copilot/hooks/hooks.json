{
  "version": 1,
  "hooks": {
    "sessionEnd": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/bell.py",
        "powershell": "python \"$HOME/.copilot/hooks/scripts/bell.py\""
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/load-required-skills.py",
        "powershell": "python \"$HOME/.copilot/hooks/scripts/load-required-skills.py\"",
        "env": {
          "AGENTS_REQUIRED_SKILL_FILES": "caveman/SKILL.md"
        }
      }
    ]
  }
}
