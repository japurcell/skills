{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "agentStop"
        }
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "errorOccurred"
        }
      }
    ],
    "notification": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "notification"
        }
      }
    ],
    "permissionRequest": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "permissionRequest"
        }
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "postToolUse"
        }
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "preToolUse"
        }
      },
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/tool-guard.py",
        "env": {
          "GUARD_MODE": "block"
        },
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/scan-secrets.py",
        "env": {
          "SCAN_MODE": "block",
          "SCAN_SCOPE": "diff"
        },
        "timeoutSec": 30
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "preCompact"
        }
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "postToolUseFailure"
        }
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "subagentStart"
        }
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "subagentStop"
        }
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "sessionEnd"
        }
      },
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/bell.py"
      },
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/scan-secrets.py",
        "env": {
          "SCAN_MODE": "warn",
          "SCAN_SCOPE": "diff"
        },
        "timeoutSec": 30
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "sessionStart"
        }
      },
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/load-required-skills.py",
        "env": {
          "AGENTS_REQUIRED_SKILL_FILES": "caveman/SKILL.md"
        }
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "userPromptSubmitted"
        }
      }
    ],
    "userPromptTransformed": [
      {
        "type": "command",
        "bash": "$HOME/.copilot/hooks/scripts/send-event.py",
        "env": {
          "OBSERVABILITY_CAPTURE_EVENT": "true",
          "OBSERVABILITY_SOURCE_EVENT_NAME": "userPromptTransformed"
        }
      }
    ]
  }
}
